PORT=3000
REDIS_URL=redis://redis:6379
DATABASE_URL=postgres://otp:otp@postgres:5432/otp
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_COOLDOWN_SECONDS=60

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
GOOGLE_CLIENT_ID=

# Random long string used to sign the session cookie
SESSION_SECRET=change-me-to-a-random-string

# Set to "true" to actually send email via SendGrid; "false" logs the OTP to console instead
EMAIL_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
